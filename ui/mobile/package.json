{
  "name": "@rashwright/ui-mobile",
  "version": "0.1.0",
  "description": "Bibliothèque de composants UI Mobile pour l'écosystème Rashwright (React Native, Expo, NativeWind, Liquid Glass)",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./components/*": "./components/*.tsx",
    "./hooks/*": "./hooks/*.ts",
    "./utils/*": "./utils/*.ts",
    "./contexts/*": "./contexts/*.tsx",
    "./stores/*": "./stores/*.ts",
    "./types/*": "./types/*.ts",
    "./configs/*": "./configs/*.ts"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "expo": ">=56.0.0",
    "react": ">=18.3.0",
    "react-native": ">=0.85.0"
  },
  "dependencies": {
    "@rashwright/core": "workspace:*",
    "@rashwright/upload": "workspace:*",
    "@rashwright/utils": "workspace:*",
    "@rashwright/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.5.0"
  }
}
